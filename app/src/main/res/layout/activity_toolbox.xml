<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/df_bg_surface"
    android:fitsSystemWindows="true">

    <!-- Top App Bar (unc0ver style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/df_bg_surface">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_df_icon_btn"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="TOOLBOX"
            android:textColor="@color/df_text_heading"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/df_border_default" />

    <!-- Content Scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- SECTION 1: ROOT PACKAGE INSTALLER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PACKAGE INSTALLER (UID 0)"
                android:textColor="@color/df_text_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_df_card"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvSelectedApk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No APK selected"
                    android:textColor="@color/df_text_body"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvApkDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select an APK file to install silently with root privileges."
                    android:textColor="@color/df_text_dim"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <!-- Checkbox toggles -->
                <CheckBox
                    android:id="@+id/cbDowngrade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Allow Downgrade (-d)"
                    android:textColor="@color/df_text_body"
                    android:textSize="13sp"
                    android:checked="true" />

                <CheckBox
                    android:id="@+id/cbGrantPerms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto Grant Runtime Permissions (-g)"
                    android:textColor="@color/df_text_body"
                    android:textSize="13sp"
                    android:checked="true"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSelectApk"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="CHOOSE APK"
                        android:textColor="@color/df_text_heading"
                        android:background="@drawable/bg_df_option_card"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnInstallApk"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="INSTALL (ROOT)"
                        android:textColor="@color/df_btn_text"
                        android:background="@drawable/bg_df_btn_root"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:enabled="false" />

                </LinearLayout>

            </LinearLayout>


            <!-- SECTION 2: CUSTOM FONT MANAGER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CUSTOM FONT MANAGER (OVERLAY)"
                android:textColor="@color/df_text_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_df_card"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvFontStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: Stock System Font"
                    android:textColor="@color/df_text_body"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvSelectedFont"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No TTF/OTF font selected"
                    android:textColor="@color/df_text_dim"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <!-- Font Preview Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_df_option_card"
                    android:padding="12dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PREVIEW"
                        android:textColor="@color/df_text_dim"
                        android:textSize="10sp"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvFontPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="The quick brown fox jumps over the lazy dog. 0123456789"
                        android:textColor="@color/df_text_heading"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnSelectFont"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="CHOOSE TTF"
                        android:textColor="@color/df_text_heading"
                        android:background="@drawable/bg_df_option_card"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnApplyFont"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="APPLY FONT"
                        android:textColor="@color/df_btn_text"
                        android:background="@drawable/bg_df_btn_root"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:enabled="false" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnResetFont"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="RESTORE STOCK FONT"
                    android:textColor="@color/df_text_muted"
                    android:background="@drawable/bg_df_option_card"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

            </LinearLayout>


            <!-- SECTION 3: OPERATION LOG CONSOLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPERATION LOG"
                android:textColor="@color/df_text_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_df_card"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvToolboxLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="5"
                    android:text="Ready."
                    android:fontFamily="monospace"
                    android:textColor="@color/df_text_body"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
