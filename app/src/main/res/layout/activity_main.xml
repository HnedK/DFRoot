<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/df_bg_surface"
    android:fitsSystemWindows="true">

    <!-- Main Screen Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_df_icon_btn"
                android:src="@drawable/ic_settings"
                android:contentDescription="Settings"
                android:scaleType="centerInside" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DFROOT"
                    android:textColor="@color/df_text_heading"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Samsung Jailbreak"
                    android:textColor="@color/df_text_muted"
                    android:textSize="10sp"
                    android:letterSpacing="0.02" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnTerminal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_df_icon_btn"
                android:src="@drawable/ic_terminal"
                android:contentDescription="Terminal"
                android:scaleType="centerInside" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/df_border_default" />

        <!-- Scrollable Middle Body -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Hero Section (Lock Logo & Credits) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="16dp">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_df_card"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_lock_logo"
                            android:contentDescription="Lock Logo" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Engine by diabl0w, snothin, hnedk"
                        android:textColor="@color/df_text_heading"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="KernelSU LKM for kernel 6.6.50"
                        android:textColor="@color/df_text_muted"
                        android:textSize="11sp"
                        android:gravity="center" />

                </LinearLayout>

                <!-- System Info Card -->
                <LinearLayout
                    android:id="@+id/cardSystemInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_df_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DEVICE"
                                android:textColor="@color/df_text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDeviceInfo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Samsung A14 5G (SM-A146P)"
                                android:textColor="@color/df_text_heading"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvRootBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_df_tag_idle"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="Unrooted"
                            android:textColor="@color/df_text_body"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/df_border_default"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="KERNEL"
                                android:textColor="@color/df_text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvKernelInfo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="6.6.50-android15"
                                android:textColor="@color/df_text_heading"
                                android:textSize="12sp"
                                android:fontFamily="monospace" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SELINUX"
                                android:textColor="@color/df_text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSelinuxStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Permissive"
                                android:textColor="@color/df_status_success_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Progress / Status Card -->
                <LinearLayout
                    android:id="@+id/cardProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_df_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Exploit Status"
                            android:textColor="@color/df_text_heading"
                            android:textStyle="bold"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvStepIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="[Ready]"
                            android:textColor="@color/df_text_heading"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:progressDrawable="@drawable/progress_df_horizontal"
                        android:max="100"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/tvStepDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap 'ROOT' button below to begin"
                        android:textColor="@color/df_text_muted"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:singleLine="true"
                        android:ellipsize="end" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- Bottom Action Button Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp"
            android:background="@color/df_bg_surface">

            <Button
                android:id="@+id/btnRun"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_df_btn_root"
                android:text="ROOT"
                android:textColor="@color/df_btn_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Sheet Modal Container -->
    <FrameLayout
        android:id="@+id/bottomSheetContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Scrim Overlay Background -->
        <View
            android:id="@+id/sheetOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#A6000000" />

        <!-- Bottom Sheet Card -->
        <LinearLayout
            android:id="@+id/sheetCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@drawable/bg_df_bottom_sheet"
            android:padding="20dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_df_tag_idle"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Jailbreak Mode"
                android:textColor="@color/df_text_heading"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"
                android:text="Choose operational mode before exploitation"
                android:textColor="@color/df_text_muted"
                android:textSize="12sp" />

            <!-- Option 1: KernelSU -->
            <LinearLayout
                android:id="@+id/optKernelSU"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_df_option_card_selected"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KernelSU (Recommended)"
                        android:textColor="@color/df_text_heading"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Module support, Superuser tab &amp; full hooking"
                        android:textColor="@color/df_text_muted"
                        android:textSize="11sp" />

                </LinearLayout>

                <RadioButton
                    android:id="@+id/radioKernelSU"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:clickable="false" />

            </LinearLayout>

            <!-- Detected Manager Info Box -->
            <LinearLayout
                android:id="@+id/boxManagerInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_df_tag_idle"
                android:padding="10dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Detected Manager:"
                    android:textColor="@color/df_text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvDetectedManager"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="me.weishu.kernelsu"
                    android:textColor="@color/df_text_heading"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Option 2: Shell Mode -->
            <LinearLayout
                android:id="@+id/optShell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_df_option_card"
                android:padding="14dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Root Shell Daemon"
                        android:textColor="@color/df_text_heading"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Port 1337 daemon + Shizuku (No manager required)"
                        android:textColor="@color/df_text_muted"
                        android:textSize="11sp" />

                </LinearLayout>

                <RadioButton
                    android:id="@+id/radioShell"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:clickable="false" />

            </LinearLayout>

            <!-- Sheet Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <Button
                    android:id="@+id/btnSheetCancel"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_df_card"
                    android:text="Cancel"
                    android:textColor="@color/df_text_body"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnSheetConfirm"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1.4"
                    android:background="@drawable/bg_df_btn_root"
                    android:text="Confirm &amp; Run"
                    android:textColor="@color/df_btn_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
